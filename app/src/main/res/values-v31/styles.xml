<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- FastGallery: Android 12+ always shows a launch splash on cold start. Make it a plain black screen (the app's
         background) instead of the icon on a white circle, so opening the app looks like going straight to the albums. -->
    <style name="AppTheme" parent="AppTheme.Base">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
    </style>

    <!-- FastGallery fast8: MainActivity's manifest theme. Android does not create a launch splash window for an
         activity whose theme is translucent, so tapping the icon goes straight to the first frame (the albums).
         MainActivity.onCreate calls setTranslucent(false) + an opaque window format right away, so the album grid
         is a normal opaque window (activity below gets stopped, no blending) for its whole life. -->
    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- fast11: the same for the screens other apps open (VIEW photo/video, REVIEW, EDIT, ATTACH_DATA): LaunchTheme on
         the AppTheme ones, this on ViewPagerActivity. SimpleActivity.onCreate makes the window opaque again. -->
    <style name="ViewerLaunchTheme" parent="TranslucentTheme">
        <item name="android:windowIsTranslucent">true</item>
    </style>

</resources>

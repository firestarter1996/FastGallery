<?xml version="1.0" encoding="utf-8"?>
<!-- fast21 floating bottom bar, shared by the folder list and (fast23) the album grid -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fg_bottom_bar"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    android:baselineAligned="false"
    android:clickable="true"
    android:elevation="6dp"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp">

    <LinearLayout
        android:id="@+id/fg_tab_camera"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="6dp"
        android:layout_weight="1"
        android:contentDescription="@string/fg_tab_camera"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_camera_vector" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/fg_tab_camera"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fg_tab_gallery"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="6dp"
        android:layout_weight="1"
        android:contentDescription="@string/fg_tab_gallery"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fg_tab_gallery" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/fg_tab_gallery"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fg_tab_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="6dp"
        android:layout_weight="1"
        android:contentDescription="@string/fg_tab_search"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search_vector" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/fg_tab_search"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fg_tab_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="6dp"
        android:layout_weight="1"
        android:contentDescription="@string/fg_tab_settings"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_settings_cog_vector" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/fg_tab_settings"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
